---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import TopLayout from "@layouts/TopLayout.astro";
import BottomLayout from "@layouts/BottomLayout.astro";
import ServiceIcon from "@components/ServiceIcon.astro";
import { Check, ArrowRight } from "@lucide/astro";
import { readingTime } from "@lib/utils";

const businessSystemCards = [
  { icon: "chart", title: "CRM System", summary: "Customer Relationship Management for sales and support", features: ["Lead Management", "Customer Profiles", "Sales Pipeline", "Reporting Dashboard"] },
  { icon: "users", title: "HR Management", summary: "Complete HR solution for employee management", features: ["Employee Database", "Leave Management", "Payroll Integration", "Performance Reviews"] },
  { icon: "graduation", title: "LMS Platform", summary: "Learning Management System for education", features: ["Course Management", "Student Progress", "Quiz System", "Certificate Generation"] },
  { icon: "briefcase", title: "Employee Management", summary: "Streamlined employee workflow management", features: ["Attendance Tracking", "Task Management", "Document Storage", "Team Collaboration"] },
];

export async function getStaticPaths() {
  const services = await getCollection("services");
  return services.map((service) => ({
    params: { slug: service.slug },
    props: service,
  }));
}

type Props = CollectionEntry<"services">;
const service = Astro.props;
const { title, summary, description, features, price, icon } = service.data;
const { body } = service;

// Get the next and prev entries (modulo to wrap index)
const items = (await getCollection("services"))
  .filter(post => !post.data.draft)
  .sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
const index = items.findIndex(x => x.slug === service.slug);
const prev = items[(index - 1 + items.length) % items.length];
const next = items[(index + 1) % items.length];
---

<PageLayout title={title} description={summary}>
  <TopLayout>
    <div class="animate">
      <div>
        <!-- Back to Services Link -->
        <a href="/services" class="group w-fit p-1.5 gap-1.5 text-sm flex items-center border rounded hover:bg-black/5 hover:dark:bg-white/10 border-black/15 dark:border-white/20 transition-colors duration-300 ease-in-out">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="stroke-current group-hover:stroke-black group-hover:dark:stroke-white">
            <line x1="19" y1="12" x2="5" y2="12" class="scale-x-0 group-hover:scale-x-100 translate-x-3 group-hover:translate-x-0 transition-all duration-300 ease-in-out" />
            <polyline points="12 19 5 12 12 5" class="translate-x-1 group-hover:translate-x-0 transition-all duration-300 ease-in-out" />
          </svg>
          <div class="w-full group-hover:text-black group-hover:dark:text-white transition-colors duration-300 ease-in-out">
            Back to services
          </div>
        </a>
        <!-- Metadata (using order instead of date) -->
        <div class="flex flex-wrap text-sm uppercase mt-12 gap-3 opacity-75">
          <div class="flex items-center gap-2">
            <svg class="size-5 stroke-current">
              <use href="/ui.svg#book-open"/>
            </svg>
            {readingTime(body)}
          </div>
        </div>
        <h1 class="text-3xl font-semibold text-black dark:text-white mt-2">
          {title}
        </h1>
        <div class="mt-1">
          {summary}
        </div>
      </div>
    </div>
  </TopLayout>
  <BottomLayout>
    <div class="animate">
      <article class="max-w-none">
        <!-- Hero Pricing Section -->
        <div class="bg-gradient-to-br from-blue-50 to-indigo-100 dark:from-blue-900/20 dark:to-indigo-900/20 rounded-2xl p-8 mb-8 text-center">
          <div class="max-w-2xl mx-auto">
            {icon && (
              <div class="flex justify-center mb-6">
                <div class="p-4 rounded-xl bg-black text-white dark:bg-white dark:text-black">
                  <ServiceIcon name={icon} class="size-10" />
                </div>
              </div>
            )}
            <h1 class="text-4xl font-bold text-gray-900 dark:text-white mb-4">
              {title}
            </h1>
            <p class="text-xl text-gray-600 dark:text-gray-300 mb-6">{summary}</p>
            {price && (
              <div class="inline-flex items-baseline gap-2 bg-white dark:bg-gray-800 px-6 py-4 rounded-2xl shadow-lg">
                <span class="text-4xl font-bold text-blue-600 dark:text-blue-400">{price}</span>
                <span class="text-gray-500 dark:text-gray-400">Starting from</span>
              </div>
            )}
          </div>
        </div>

        <!-- Features & Description Grid -->
        <div class="grid lg:grid-cols-3 gap-8 mb-12">
          <div class="lg:col-span-2">
            <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700">
              <h2 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white">Service Overview</h2>
              <p class="text-gray-700 dark:text-gray-300 leading-relaxed">{description}</p>
            </div>
          </div>
          <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-100 dark:border-gray-700">
            <h2 class="text-2xl font-bold mb-4 text-gray-900 dark:text-white">What's Included</h2>
            <ul class="space-y-3">
              {features.map((feature) => (
                <li class="flex items-center gap-3 text-gray-700 dark:text-gray-300 p-2 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700/50 transition-colors">
                  <Check class="w-5 h-5 text-green-500 flex-shrink-0" stroke-width={2.5} />
                  <span>{feature}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Additional Business Systems Section -->
        <div class="mb-12">
          <h2 class="text-3xl font-bold text-center mb-8 text-gray-900 dark:text-white">Business Management Systems</h2>
          <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
            {businessSystemCards.map((card) => (
              <div class="group bg-white dark:bg-gray-800 rounded-xl shadow-sm hover:shadow-lg transition-all duration-300 border border-gray-100 dark:border-gray-700 overflow-hidden">
                <div class="p-6 text-center">
                  <div class="flex justify-center mb-4">
                    <div class="p-2.5 rounded-lg bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400">
                      <ServiceIcon name={card.icon} class="size-6" />
                    </div>
                  </div>
                  <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">{card.title}</h3>
                  <p class="text-sm text-gray-600 dark:text-gray-300 mb-4">{card.summary}</p>
                  <ul class="text-xs text-gray-500 dark:text-gray-400 space-y-1 mb-4">
                    {card.features.map((feature) => (
                      <li>{feature}</li>
                    ))}
                  </ul>
                  <div class="text-lg font-bold text-blue-600 dark:text-blue-400">$15</div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- Call to Action -->
        <div class="bg-gradient-to-r from-gray-900 to-gray-800 dark:from-gray-800 dark:to-gray-900 rounded-2xl p-8 text-center text-white mb-8">
          <h2 class="text-2xl font-bold mb-4">Ready to Grow Your Business Online?</h2>
          <p class="text-gray-300 mb-6 max-w-xl mx-auto">
            Let's build a solution that generates leads, wins customers, and supports your growth.
          </p>
          <a href="/contact" class="inline-flex items-center gap-2 bg-white text-gray-900 px-6 py-3 rounded-lg font-semibold hover:bg-gray-100 transition-colors">
            Get Free Consultation
            <ArrowRight class="w-4 h-4" stroke-width={2.5} />
          </a>
        </div>

        <!-- Prev/Next Navigation -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-8 pt-8 border-t border-gray-200 dark:border-gray-700">
          <a href={`/${prev.collection}/${prev.slug}`} class="group p-4 gap-3 flex items-center border rounded-lg hover:bg-black/5 hover:dark:bg-white/10 border-black/15 dark:border-white/20 blend">
            <div class="order-2 w-full h-full group-hover:text-black group-hover:dark:text-white blend">
              <div class="flex flex-wrap gap-2">
                <div class="text-sm uppercase">
                  Prev
                </div>
              </div>
              <div class="font-semibold mt-3 text-black dark:text-white">
                {prev.data.title}
              </div>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="order-1 stroke-current group-hover:stroke-black group-hover:dark:stroke-white rotate-180">
              <line x1="5" y1="12" x2="19" y2="12" class="scale-x-0 group-hover:scale-x-100 translate-x-4 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
              <polyline points="12 5 19 12 12 19" class="translate-x-0 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
            </svg>
          </a>
          <a href={`/${next.collection}/${next.slug}`} class="group p-4 gap-3 flex items-center border rounded-lg hover:bg-black/5 hover:dark:bg-white/10 border-black/15 dark:border-white/20 transition-colors duration-300 ease-in-out">
            <div class="w-full h-full text-right group-hover:text-black group-hover:dark:text-white blend">
              <div class="text-sm uppercase">
                Next
              </div>
              <div class="font-semibold mt-3 text-black dark:text-white">
                {next.data.title}
              </div>
            </div>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="stroke-current group-hover:stroke-black group-hover:stroke-white">
              <line x1="5" y1="12" x2="19" y2="12" class="scale-x-0 group-hover:scale-x-100 translate-x-4 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
              <polyline points="12 5 19 12 12 19" class="translate-x-0 group-hover:translate-x-1 transition-all duration-300 ease-in-out" />
            </svg>
          </a>
        </div>
      </article>
    </div>
  </BottomLayout>
</PageLayout>