---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import TopLayout from "@layouts/TopLayout.astro";
import BottomLayout from "@layouts/BottomLayout.astro";
import ServiceIcon from "@components/ServiceIcon.astro";
import { Check, X, ArrowRight } from "@lucide/astro";
import { SERVICES } from "@consts";

const services = (await getCollection("services"))
  .filter((service) => !service.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const getIsPopular = (slug: string): boolean => slug === "business-website";

const serviceDetailsJSON = JSON.stringify(
  services.reduce((acc: Record<string, unknown>, service) => {
    acc[service.slug] = {
      title: service.data.title,
      icon: service.data.icon,
      price: service.data.price,
      summary: service.data.summary,
      description: service.data.description,
      features: service.data.features,
      tags: service.data.tags,
    };
    return acc;
  }, {})
);

const businessSystems: Array<{
  slug: string;
  title: string;
  icon: string;
  price: string;
  summary: string;
  description: string;
  features: string[];
  tags: string[];
}> = [
  {
    slug: "crm-system",
    title: "CRM System",
    icon: "chart",
    price: "$15",
    summary: "Customer Relationship Management for sales and support",
    description:
      "Build a comprehensive CRM system to manage customer interactions, track sales pipelines, and improve customer relationships. Features include lead management, customer profiles, sales automation, and detailed analytics.",
    features: [
      "Lead and contact management",
      "Sales pipeline tracking",
      "Customer communication history",
      "Task and activity management",
      "Reporting and analytics dashboard",
      "Email integration",
      "Document storage",
      "Custom workflow automation",
    ],
    tags: ["CRM", "Sales", "Business", "Automation"],
  },
  {
    slug: "hr-management",
    title: "HR Management System",
    icon: "users",
    price: "$15",
    summary: "Complete HR solution for employee management",
    description:
      "Develop a full-featured HR management system to streamline employee onboarding, payroll, performance reviews, and leave management. Centralize all HR operations in one platform.",
    features: [
      "Employee database and profiles",
      "Leave and attendance management",
      "Payroll system integration",
      "Performance review system",
      "Document management",
      "Recruitment and onboarding",
      "Training and development tracking",
      "Compliance management",
    ],
    tags: ["HR", "Management", "Employee", "Business"],
  },
  {
    slug: "lms-platform",
    title: "LMS Platform",
    icon: "graduation",
    price: "$15",
    summary: "Learning Management System for education and training",
    description:
      "Create a powerful Learning Management System for educational institutions and corporate training. Deliver courses, track progress, and manage certifications efficiently.",
    features: [
      "Course creation and management",
      "Student enrollment and progress tracking",
      "Quiz and assignment system",
      "Video and content delivery",
      "Certificate generation",
      "Discussion forums",
      "Grade book and reporting",
      "Mobile learning support",
    ],
    tags: ["LMS", "Education", "E-learning", "Training"],
  },
  {
    slug: "employee-management",
    title: "Employee Management System",
    icon: "briefcase",
    price: "$15",
    summary: "Streamlined employee workflow management",
    description:
      "Build an employee management system that simplifies task assignment, time tracking, project management, and team collaboration for businesses of all sizes.",
    features: [
      "Task and project management",
      "Time tracking and timesheets",
      "Team collaboration tools",
      "Performance monitoring",
      "Document sharing",
      "Attendance tracking",
      "Goal setting and tracking",
      "Integration with other tools",
    ],
    tags: ["Employee", "Management", "Productivity", "Business"],
  },
];

const outcomes = [
  {
    icon: "trending",
    title: "Get Found Online",
    description:
      "SEO-ready structure, fast mobile performance, and clear service pages so customers discover your business on Google.",
  },
  {
    icon: "target",
    title: "Generate Leads",
    description:
      "Conversion-focused layouts, contact forms, and strong CTAs that turn visitors into inquiries and booked jobs.",
  },
  {
    icon: "megaphone",
    title: "Win More Customers",
    description:
      "Trust-building content, professional branding, and analytics-ready setup to grow credibility and repeat business.",
  },
];

const commonFeatures = [
  "Responsive Design",
  "Mobile Optimization",
  "SEO Friendly",
  "Fast Loading",
  "Cross-browser Compatible",
  "Clean Code",
  "Performance Optimization",
  "Ongoing Support",
  "Custom Features",
  "Database Design",
  "API Development",
  "User Authentication",
  "Admin Panel",
  "Payment Integration",
  "Reporting Dashboard",
  "User Management",
  "Data Analytics",
  "Cloud Deployment",
];
---

<PageLayout title={SERVICES.TITLE} description={SERVICES.DESCRIPTION}>
  <TopLayout containerSize="xl">
    <div class="animate">
      <div class="text-center max-w-4xl mx-auto">
        <h1 class="text-3xl font-bold text-black dark:text-white mt-2">
          {SERVICES.TITLE}
        </h1>
        <div class="mt-3 text-base text-gray-600 dark:text-gray-300">
          {SERVICES.DESCRIPTION}
        </div>
        <p class="mt-4 text-sm text-gray-500 dark:text-gray-400 max-w-2xl mx-auto leading-relaxed">
          I help local and online businesses grow with websites and web systems designed to attract visitors,
          capture leads, and convert interest into paying customers.
        </p>
      </div>
    </div>
  </TopLayout>
  <BottomLayout containerSize="xl">
    <div class="animate">
      <!-- Outcomes -->
      <section class="mb-16">
        <h2 class="text-xl font-bold text-center mb-2 text-gray-900 dark:text-white">
          How I Help You Grow
        </h2>
        <p class="text-center text-sm text-gray-600 dark:text-gray-300 mb-8 max-w-xl mx-auto">
          Every project is built around real business outcomes—not just code.
        </p>
        <div class="grid md:grid-cols-3 gap-6">
          {outcomes.map((outcome) => (
            <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 p-6 text-center">
              <div class="flex justify-center mb-4">
                <div class="p-3 rounded-lg bg-black text-white dark:bg-white dark:text-black">
                  <ServiceIcon name={outcome.icon} class="size-6" />
                </div>
              </div>
              <h3 class="text-base font-bold text-gray-900 dark:text-white mb-2">{outcome.title}</h3>
              <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed">{outcome.description}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Web Development Services -->
      <section class="mb-16">
        <h2 class="text-2xl font-bold text-center mb-2 text-gray-900 dark:text-white">
          Growth-Focused Web Services
        </h2>
        <p class="text-center text-sm text-gray-600 dark:text-gray-300 mb-8 max-w-2xl mx-auto">
          From lead-generating business websites to full-stack platforms that support your operations.
        </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 max-w-5xl mx-auto mb-8">
          {services.map((service) => {
            const isPopular = getIsPopular(service.slug);
            return (
              <div
                class={`group relative flex flex-col bg-white dark:bg-gray-800 rounded-xl shadow-sm hover:shadow-lg transition-all duration-300 border overflow-hidden ${
                  isPopular
                    ? "border-gray-300 dark:border-gray-400"
                    : "border-gray-100 dark:border-gray-700"
                }`}
              >
                {isPopular && (
                  <div class="absolute top-0 left-1/2 transform -translate-x-1/2 bg-black text-white dark:bg-white dark:text-black px-3 py-1 rounded-full text-xs font-semibold z-10">
                    Most Popular
                  </div>
                )}
                <div class="flex flex-col h-full p-5 md:p-6 pt-8">
                  <div class="text-center mb-4">
                    <div class="flex justify-center mb-3">
                      {service.data.icon && (
                        <div
                          class={`p-2.5 rounded-lg ${
                            isPopular
                              ? "bg-black text-white dark:bg-white dark:text-black"
                              : "bg-gray-100 text-gray-900 dark:bg-gray-700 dark:text-white"
                          }`}
                        >
                          <ServiceIcon name={service.data.icon} class="size-6" />
                        </div>
                      )}
                    </div>
                    <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">
                      {service.data.title}
                    </h3>
                    <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed line-clamp-3">
                      {service.data.summary}
                    </p>
                  </div>

                  {service.data.price && (
                    <div class="text-center mb-4">
                      <div class="text-gray-900 dark:text-white">
                        <span class="text-2xl font-bold">{service.data.price}</span>
                        <span class="text-base font-medium">/hour</span>
                      </div>
                      <div class="text-xs text-gray-500 dark:text-gray-400">Starting from</div>
                    </div>
                  )}

                  <ul class="space-y-2 mb-4 flex-grow">
                    {service.data.features.slice(0, 3).map((feature) => (
                      <li class="flex items-start gap-2 text-sm text-gray-600 dark:text-gray-300">
                        <Check class="w-4 h-4 text-green-500 flex-shrink-0 mt-0.5" stroke-width={2.5} />
                        <span class="leading-snug">{feature}</span>
                      </li>
                    ))}
                    {service.data.features.length > 3 && (
                      <li class="text-xs text-blue-600 dark:text-blue-400 font-medium">
                        + {service.data.features.length - 3} more features
                      </li>
                    )}
                  </ul>

                  <button
                    type="button"
                    data-service-slug={service.slug}
                    class={`service-details-btn mt-auto w-full text-center py-2.5 px-3 rounded-lg font-medium transition-all duration-300 text-sm ${
                      isPopular
                        ? "bg-black hover:bg-gray-800 text-white dark:bg-white dark:hover:bg-gray-200 dark:text-black shadow-md"
                        : "bg-gray-100 hover:bg-gray-200 dark:bg-gray-700 dark:hover:bg-gray-600 text-gray-900 dark:text-white"
                    }`}
                  >
                    View Details
                  </button>
                </div>
              </div>
            );
          })}
        </div>
      </section>

      <!-- Business Management Systems -->
      <section class="mb-16">
        <h2 class="text-2xl font-bold text-center mb-8 text-gray-900 dark:text-white">
          Business Management Systems
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 max-w-5xl mx-auto mb-8">
          {businessSystems.map((system) => (
            <div class="group relative flex flex-col bg-white dark:bg-gray-800 rounded-xl shadow-sm hover:shadow-lg transition-all duration-300 border border-gray-100 dark:border-gray-700 overflow-hidden">
              <div class="flex flex-col h-full p-5 md:p-6 text-center">
                <div class="flex justify-center mb-4">
                  <div class="p-2.5 rounded-lg bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400">
                    <ServiceIcon name={system.icon} class="size-6" />
                  </div>
                </div>
                <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-2">{system.title}</h3>
                <p class="text-sm text-gray-600 dark:text-gray-300 mb-4 leading-relaxed line-clamp-3">{system.summary}</p>

                <div class="text-center mb-4">
                  <div class="text-gray-900 dark:text-white">
                    <span class="text-xl font-bold">{system.price}</span>
                    <span class="text-sm">/hour</span>
                  </div>
                  <div class="text-xs text-gray-500 dark:text-gray-400">Starting from</div>
                </div>

                <ul class="space-y-2 mb-4 flex-grow text-left">
                  {system.features.slice(0, 3).map((feature) => (
                    <li class="flex items-start gap-2 text-sm text-gray-600 dark:text-gray-300">
                      <Check class="w-4 h-4 text-green-500 flex-shrink-0 mt-0.5" stroke-width={2.5} />
                      <span class="leading-snug">{feature}</span>
                    </li>
                  ))}
                  {system.features.length > 3 && (
                    <li class="text-xs text-blue-600 dark:text-blue-400 font-medium">
                      + {system.features.length - 3} more features
                    </li>
                  )}
                </ul>

                <button
                  type="button"
                  data-system-slug={system.slug}
                  class="business-details-btn mt-auto w-full text-center py-2.5 px-3 rounded-lg font-medium transition-all duration-300 text-sm bg-blue-100 hover:bg-blue-200 dark:bg-blue-900/30 dark:hover:bg-blue-900/50 text-blue-600 dark:text-blue-400"
                >
                  View Details
                </button>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Service Details Modal -->
      <div
        id="serviceModal"
        class="fixed inset-0 bg-black/50 z-50 hidden items-center justify-center p-4"
        role="dialog"
        aria-modal="true"
        aria-labelledby="modalTitle"
      >
        <div class="bg-white dark:bg-gray-800 rounded-xl max-w-2xl w-full max-h-[80vh] overflow-y-auto">
          <div class="p-6">
            <div class="flex justify-between items-start gap-4 mb-4">
              <div class="flex items-center gap-3">
                <div
                  id="modalIconWrap"
                  class="hidden p-2 rounded-lg bg-black text-white dark:bg-white dark:text-black"
                >
                  <span id="modalIconLabel" class="text-xs font-medium uppercase tracking-wide"></span>
                </div>
                <h3 id="modalTitle" class="text-xl font-bold text-gray-900 dark:text-white"></h3>
              </div>
              <button
                type="button"
                id="modalCloseBtn"
                class="text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 p-1"
                aria-label="Close"
              >
                <X class="w-6 h-6" stroke-width={2} />
              </button>
            </div>
            <div id="modalContent"></div>
          </div>
        </div>
      </div>

      <script is:inline id="serviceDetailsData" type="application/json" set:html={serviceDetailsJSON} />
      <script is:inline id="businessSystemsData" type="application/json" set:html={JSON.stringify(businessSystems)} />

      <!-- Comparison Table -->
      <div class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-100 dark:border-gray-700 p-6 mb-12 mx-auto">
        <h2 class="text-xl font-bold text-center mb-6 text-gray-900 dark:text-white">Service Comparison</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-gray-200 dark:border-gray-600">
                <th class="text-left pb-3 font-semibold text-gray-900 dark:text-white">Features & Services</th>
                {services.map((service) => (
                  <th class="text-center pb-3 font-semibold text-gray-900 dark:text-white min-w-[5rem]">
                    {service.data.title}
                  </th>
                ))}
                {businessSystems.map((system) => (
                  <th class="text-center pb-3 font-semibold text-gray-900 dark:text-white min-w-[5rem]">
                    {system.title}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {commonFeatures.map((feature) => (
                <tr class="border-b border-gray-100 dark:border-gray-700">
                  <td class="py-3 text-gray-700 dark:text-gray-300 font-medium">{feature}</td>
                  {services.map((service) => {
                    const excludedFeatures = ["Payment Integration", "Cloud Deployment"];
                    const hasFeature =
                      !excludedFeatures.includes(feature) ||
                      service.data.features.some((f) =>
                        f.toLowerCase().includes(feature.toLowerCase().split(" ")[0])
                      );
                    return (
                      <td class="text-center py-3">
                        {hasFeature ? (
                          <Check class="w-4 h-4 text-green-500 mx-auto" stroke-width={2.5} />
                        ) : (
                          <X class="w-4 h-4 text-gray-300 dark:text-gray-600 mx-auto" stroke-width={2.5} />
                        )}
                      </td>
                    );
                  })}
                  {businessSystems.map((system) => {
                    const excludedFeatures = ["SEO Friendly", "Cross-browser Compatible"];
                    const hasFeature =
                      !excludedFeatures.includes(feature) ||
                      system.features.some((f) =>
                        f.toLowerCase().includes(feature.toLowerCase().split(" ")[0])
                      );
                    return (
                      <td class="text-center py-3">
                        {hasFeature ? (
                          <Check class="w-4 h-4 text-green-500 mx-auto" stroke-width={2.5} />
                        ) : (
                          <X class="w-4 h-4 text-gray-300 dark:text-gray-600 mx-auto" stroke-width={2.5} />
                        )}
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- CTA -->
      <div class="bg-gradient-to-r from-gray-900 to-gray-800 dark:from-gray-800 dark:to-gray-900 rounded-xl p-8 text-center text-white mb-12">
        <h2 class="text-2xl font-bold mb-3">Ready to Grow Your Business Online?</h2>
        <p class="text-gray-300 mb-6 max-w-xl mx-auto text-sm leading-relaxed">
          Let's build a website or platform that brings you more leads, more customers, and measurable growth.
        </p>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 bg-white text-gray-900 px-6 py-3 rounded-lg font-semibold hover:bg-gray-100 transition-colors"
        >
          Get Free Consultation
          <ArrowRight class="w-4 h-4" stroke-width={2.5} />
        </a>
      </div>

      <!-- Skills Showcase -->
      <div class="bg-gradient-to-br from-gray-50 to-blue-50 dark:from-gray-900 dark:to-blue-900/20 rounded-xl p-6">
        <h2 class="text-xl font-bold text-center mb-6 text-gray-900 dark:text-white">
          Technologies I Work With
        </h2>
        <div class="flex flex-wrap justify-center gap-2">
          {[
            "JavaScript",
            "TypeScript",
            "ReactJS",
            "Next.js",
            "Node.js",
            "Express.js",
            "MongoDB",
            "Laravel",
            "SQL",
            "Tailwind CSS",
            "Bootstrap",
            "Shadcn UI",
            "Flowbite",
            "Material UI",
            "Git",
            "GitHub",
            "Vercel",
            "Firebase",
            "MySQL",
            "PostgreSQL",
            "Redis",
            "Docker",
            "AWS",
            "REST APIs",
            "GraphQL",
          ].map((tech) => (
            <span class="px-3 py-1 bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-full text-xs font-medium text-gray-700 dark:text-gray-300 hover:shadow-md transition-all hover:border-blue-200 dark:hover:border-blue-500">
              {tech}
            </span>
          ))}
        </div>
      </div>
    </div>
  </BottomLayout>
</PageLayout>

<script>
  function getDetailsData() {
    const el = document.getElementById("serviceDetailsData");
    return el ? JSON.parse(el.textContent || "{}") : {};
  }

  function getBusinessData() {
    const el = document.getElementById("businessSystemsData");
    return el ? JSON.parse(el.textContent || "[]") : [];
  }

  function renderModal(item: {
    title: string;
    summary?: string;
    description?: string;
    price?: string;
    features?: string[];
    tags?: string[];
    icon?: string;
  }) {
    const modal = document.getElementById("serviceModal");
    const titleEl = document.getElementById("modalTitle");
    const contentEl = document.getElementById("modalContent");
    const iconWrap = document.getElementById("modalIconWrap");
    const iconLabel = document.getElementById("modalIconLabel");

    if (!modal || !titleEl || !contentEl) return;

    titleEl.textContent = item.title;

    if (iconWrap && iconLabel && item.icon) {
      iconWrap.classList.remove("hidden");
      iconLabel.textContent = item.icon;
    } else if (iconWrap) {
      iconWrap.classList.add("hidden");
    }

    const featuresHtml = (item.features || [])
      .map(
        (f) =>
          `<li class="flex items-start gap-2 text-sm text-gray-600 dark:text-gray-300">
            <span class="text-green-500 mt-0.5">✓</span><span>${f}</span>
          </li>`
      )
      .join("");

    const tagsHtml = (item.tags || [])
      .map(
        (t) =>
          `<span class="px-2 py-0.5 text-xs rounded-full bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300">${t}</span>`
      )
      .join(" ");

    contentEl.innerHTML = `
      ${item.summary ? `<p class="text-gray-600 dark:text-gray-300 mb-4">${item.summary}</p>` : ""}
      ${item.description ? `<p class="text-gray-700 dark:text-gray-300 mb-4 leading-relaxed">${item.description}</p>` : ""}
      ${item.price ? `<p class="text-lg font-bold text-gray-900 dark:text-white mb-4">${item.price}<span class="text-sm font-normal text-gray-500">/hour</span></p>` : ""}
      ${featuresHtml ? `<ul class="space-y-2 mb-4">${featuresHtml}</ul>` : ""}
      ${tagsHtml ? `<div class="flex flex-wrap gap-2">${tagsHtml}</div>` : ""}
      <a href="/contact" class="inline-block mt-6 text-sm font-semibold text-blue-600 dark:text-blue-400 hover:underline">Get in touch →</a>
    `;

    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.style.overflow = "hidden";
  }

  function closeModal() {
    const modal = document.getElementById("serviceModal");
    if (!modal) return;
    modal.classList.add("hidden");
    modal.classList.remove("flex");
    document.body.style.overflow = "";
  }

  function showServiceDetails(slug: string) {
    const data = getDetailsData();
    const item = data[slug];
    if (item) renderModal(item);
  }

  function showBusinessSystemDetails(slug: string) {
    const systems = getBusinessData();
    const item = systems.find((s: { slug: string }) => s.slug === slug);
    if (item) renderModal(item);
  }

  function initServicesPage() {
    document.querySelectorAll(".service-details-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const slug = btn.getAttribute("data-service-slug");
        if (slug) showServiceDetails(slug);
      });
    });

    document.querySelectorAll(".business-details-btn").forEach((btn) => {
      btn.addEventListener("click", () => {
        const slug = btn.getAttribute("data-system-slug");
        if (slug) showBusinessSystemDetails(slug);
      });
    });

    document.getElementById("modalCloseBtn")?.addEventListener("click", closeModal);

    document.getElementById("serviceModal")?.addEventListener("click", (e) => {
      if (e.target === e.currentTarget) closeModal();
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closeModal();
    });
  }

  initServicesPage();
  document.addEventListener("astro:page-load", initServicesPage);
</script>

<style>
  .group:hover {
    transform: translateY(-2px);
  }

  #serviceModal {
    backdrop-filter: blur(4px);
  }
</style>
